{
  "tasks": {
    "serve": "deno run --allow-net --allow-read --allow-env server.ts",
    "build": "deno run -A build/esbuild-build.ts",
    "watch": "deno run -A build/esbuild-watch.ts",
    "dev": "deno run -A scripts/dev.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}

